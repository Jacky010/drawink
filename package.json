{
  "name": "drawink-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:site": "vite build --config vite.config.ts --mode pages",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.7",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Jacky010",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacky010/drawink.git"
  },
  "bugs": {
    "url": "https://github.com/Jacky010/drawink/issues"
  },
  "homepage": "https://jacky010.github.io/drawink/",
  "license": "MIT"
}
